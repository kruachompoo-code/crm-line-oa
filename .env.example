# ════════════════════════════════════════════
# ครัวชมพู่ อ่างศิลา — CRM LINE OA
# Environment Variables
# ════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# ────── LINE Messaging API ──────
# จาก LINE Developers Console → Messaging API
LINE_CHANNEL_ACCESS_TOKEN=Ly5h/dWY3x89527fEJoFLdtqDyh45flnO7dpo86rZsFpeEsWi/SF+4Nb5G5IRlAmefsbM0OqwWSA8TbIQZmZ+wCKjr9CZVDS1pE0LAGuzccZmQ6457I5BKKb7/4W9BqiTeuD9V1uLiL/RS04o4UE5AdB04t89/1O/w1cDnyilFU=
LINE_CHANNEL_SECRET=YOUR_CHANNEL_SECRET_HERE

# LINE Group ID สำหรับแจ้งพนักงาน
# วิธีหา: เพิ่ม bot เข้ากลุ่ม → ดู groupId จาก webhook log
STAFF_LINE_GROUP_ID=YOUR_STAFF_GROUP_ID

# ────── LIFF IDs ──────
# จาก LINE Developers Console → LIFF → สร้างแล้วก็อปมาใส่
LIFF_ID_WALKIN=YOUR_LIFF_ID_WALKIN
LIFF_ID_RESERVATION=YOUR_LIFF_ID_RESERVATION
LIFF_ID_GROUP=YOUR_LIFF_ID_GROUP
LIFF_ID_GROUP_MENU=YOUR_LIFF_ID_GROUP_MENU
LIFF_ID_ONBOARDING=YOUR_LIFF_ID_ONBOARDING
LIFF_ID_STAFF_VERIFY=YOUR_LIFF_ID_STAFF_VERIFY

# ────── App URL ──────
# Railway จะให้ URL อัตโนมัติ เช่น https://crm-chompu.railway.app
APP_URL=https://YOUR-APP.railway.app

# ────── Database ──────
# Railway PostgreSQL จะ inject DATABASE_URL อัตโนมัติ
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/crm_line_oa
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_line_oa
DB_USER=postgres
DB_PASSWORD=postgres123

# ────── Redis ──────
# Railway Redis จะ inject REDIS_URL อัตโนมัติ
REDIS_URL=redis://localhost:6379

# ────── JWT ──────
# สร้าง random string ยาวๆ: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# ────── Business Rules ──────
POINTS_PER_BAHT=1
SILVER_THRESHOLD=0
GOLD_THRESHOLD=3000
PLATINUM_THRESHOLD=10000
MAX_MSG_PER_WEEK=3
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# ────── Email (ใบเสนอราคา) ──────
# ถ้าใช้ Gmail: เปิด 2FA → สร้าง App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ครัวชมพู่ อ่างศิลา <your@gmail.com>

# ────── Quotation ──────
QUOTATION_DIR=/tmp/quotations
